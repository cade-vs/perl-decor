
  type    User
  label   [~System users]
  system

  web.grid.fields_list  NAME,ACTIVE,PRIMARY_GROUP,PRIVATE_GROUP,GROUPS,CREDENTIALS,LAST_LOGIN_TIME

  grant read to 971

=NAME

  label [~Login name]
  type  char  128
  unique
  grant read to 971

# ---------------------------------------------------------------------------
# DEPRECATED: PASS / PASS_SALT / PASS_XTIME have moved to DE_USER_CREDS.
# They are retained ONLY so decor-migrate-user-creds.pl can copy existing
# values across. Remove these three fields (phase 2) once migration is done
# and rebuild the database.
# ---------------------------------------------------------------------------

=PASS

  label [~Password]
  type  char  256

  web.overflow  1
  password

  grant read to 1

=PASS_SALT

  label [~Password seed]
  type  char  256

  web.overflow  1
  password

  grant read to 1

=PASS_XTIME

  label [~Password expire time]
  type  utime
  web.details 2

  grant read to 971

# --- end deprecated block --------------------------------------------------

=PRIMARY_GROUP

  label [~User primary group]
  type  link  DE_GROUPS   NAME

  grant read to 971

=PRIVATE_GROUP

  label [~User private group]
  type  link  DE_GROUPS   NAME

  grant read to 971

=GROUPS

  label [~Attached groups]
  type  backlink  DE_USER_GROUP_MAP   USR

  grant read to 971

=CREDENTIALS

  label [~Login credentials]
  type  backlink  DE_USER_CREDS   USR

  grant read to 971

=ACTIVE

  label [~Active user]
  type  bool

  grant read to 971

=DISABLED

  # usually off, used to temporary override of ACTIVE without losing state
  label [~Temporary disabled]
  type  bool

  grant read to 971

=LAST_LOGIN_TIME

  label [~Last login time]
  type  utime
  web.details 2

  grant read to 971

=LAST_LOGOUT_TIME

  label [~Last login time]
  type  utime
  web.details 2

  grant read to 971

=LAST_LOGIN_SESSION

  label [~Last login session]
  type  link DE_SESSIONS CTIME

  grant read to 971

=LAST_LOGIN_SESSION_ACTIVE

  label [~Last login active]
  type  link DE_SESSIONS ACTIVE

  grant read to 971

=LOGIN_SESSIONS

  label [~Previous login sessions]
  type  backlink  DE_SESSIONS   USR

  grant read to 971

=SESSIONLESS

  label [~Sessionsless]
  type  bool

  grant read to 1
